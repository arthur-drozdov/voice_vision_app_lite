# STT Configuration
STT_PROVIDER=deepgram  # Options: deepgram, whisper, local_whisper
DEEPGRAM_API_KEY=your_deepgram_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # For Whisper API
WHISPER_MODEL=base  # For local Whisper: tiny, base, small, medium, large

# TTS Configuration
TTS_PROVIDER=elevenlabs  # Options: elevenlabs, coqui
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE=Rachel  # Default voice ID for TTS

# Voice Cloning Configuration
VOICE_STORE_PATH=./data/voices

# Audio Processing
AUDIO_SAMPLE_RATE_STT=16000  # Sample rate for STT input
AUDIO_SAMPLE_RATE_TTS=24000  # Sample rate for TTS output

# Logging
LOG_LEVEL=INFO

# TTS Server WebSocket URL
TTS_SERVER_URL=ws://llm-server.example.com:8001

# STT Server WebSocket URL
STT_SERVER_URL=ws://stt-server.example.com:8002

# LLMRTC Backend Configuration
# LLMRTC backend runs separately on port 8787 (not through Vite proxy)
VITE_LLMRTC_BACKEND_URL=ws://localhost:8787
